@startuml
title Startseite aufrufen - Alle Projekte abrufen

actor "User" as user
participant "Browser/\nFrontend" as browser
participant "Express\nRouter" as router
participant "StartPage\nService" as service
database "PostgreSQL\nDatenbank" as db

== Initialisierung ==

user -> browser: Öffnet Startseite
activate browser

browser -> router: GET /api/startpage\n?sortBy=updatedAt&sortOrder=desc
activate router

router -> router: Validierung\nQuery-Parameter
note right: express-validator\nprüft Parameter

== Service Layer ==

router -> service: getStartPageData(filters)
activate service

service -> service: getOrCreateWorkspace()\nworkspaceId optional

alt workspaceId vorhanden
    service -> db: findUnique(LocalWorkspace)
    activate db
    db --> service: workspace
    deactivate db
else kein workspaceId
    service -> db: findFirst(LocalWorkspace)
    activate db
    alt workspace gefunden
        db --> service: workspace
    else kein workspace
        service -> db: create(LocalWorkspace)\n{name: "Default Workspace"}
        db --> service: new workspace
    end
    deactivate db
end

== Daten laden ==

service -> db: project.findMany()\ninclude: projectPlan, businessUnderstanding\norderBy: updatedAt desc
activate db
note right: WHERE workspaceId = workspace.id\nOptional: Filter nach status/search
db --> service: projects[]
deactivate db

== Daten aufbereiten ==


service -> service: Statistiken berechnen\n- totalProjects\n- planning, inProgress, etc.

== Response zurückgeben ==

service --> router: {\n  workspace,\n  projects[],\n  statistics,\n  totalCount\n}
deactivate service

router --> browser: HTTP 200 OK\n{\n  "success": true,\n  "data": {...}\n}
deactivate router

browser -> browser: Projekte rendern\n- Liste anzeigen\n- Statistiken darstellen\n- Filter/Sortierung

browser --> user: Startseite mit\nProjektübersicht
deactivate browser

@enduml
