{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "prisma": {
    "schema": "src/app/prismadatabase/schema.prisma"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --loader ts-node/esm src/index.ts",
    "test:db:up": "docker-compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker-compose -f docker-compose.test.yml down",
    "test:setup": "npm run test:db:up && dotenv -e .env.test -- npx prisma migrate deploy && dotenv -e .env.test -- npx prisma db seed",
    "test:e2e": "npm run test:setup && dotenv -e .env.test -- vitest run",
    "test:cleanup": "npm run test:db:down",
    "test:coverage": "npm run test:setup && dotenv -e .env.test -- vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "express": "^5.1.0",
    "express-validator": "^7.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.13",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}