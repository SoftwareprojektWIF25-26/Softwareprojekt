    },
    {
      "id": "stakeholder_support",
      "label": "Stakeholder-Unterstützung",
      "type": "select",
      "value": "hoch",
      "category": "readiness",
      "options": ["niedrig", "mittel", "hoch"]
    },
    {
      "id": "tools_available",
      "label": "Tools & Infrastruktur",
      "type": "boolean",
      "value": true,
      "category": "readiness"
    },
    {
      "id": "data_variety",
      "label": "Datenvielfalt (1-10)",
