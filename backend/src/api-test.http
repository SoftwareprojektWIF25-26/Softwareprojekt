### ===========================================
### DS PROJECT PLANNING TOOL - API TESTS
### ===========================================

### 1. Health Check
GET http://localhost:8080/api/health

### 2. Projekt erstellen
POST http://localhost:8080/api/projects
Content-Type: application/json

{
  "title": "ML Healthcare Projekt",
  "domain": "Healthcare"
}

### 3. Projekt abrufen (ID aus Response von #2 nutzen)
GET http://localhost:8080/api/projects/1

### 4. Business Understanding speichern
PATCH http://localhost:8080/api/projects/1/business-understanding
Content-Type: application/json

{
  "businessGoal": "Vorhersage von Patientenrisiken durch ML-Modell",
  "teamSize": 5,
  "timelineValue": 12,
  "timelineUnit": "WEEKS",
  "estimatedCost": 75000,
  "projectTeamRoles": ["Data Scientist", "ML Engineer", "Product Owner", "DevOps"],
  "formOfFinalProduct": "API Service",
  "toolsBusinessUnderstanding": "Jira, Confluence, Slack"
}

### 5. Data Characteristics speichern
PATCH http://localhost:8080/api/projects/1/data-characteristics
Content-Type: application/json

{
  "dataAvailability": true,
  "dataSources": ["EHR System", "Lab Database", "Patient Records"],
  "dataSecurityConstraints": "GDPR, HIPAA compliant",
  "velocity": "BATCH",
  "veracity": "MEDIUM",
  "variety": "STRUCTURED",
  "volumeValue": 500000,
  "volumeUnit": "RECORDS",
  "variability": "SOMETIMES",
  "dataAccess": ["READ", "WRITE"],
  "dataPreparationSteps": "JOINS",
  "toolsData": "PostgreSQL, Pandas, Apache Spark"
}

### 6. Analysis Config speichern (optional)
PATCH http://localhost:8080/api/projects/1/analysis-config
Content-Type: application/json

{
  "analyticsType": "PREDICTIVE",
  "dataScienceGoals": "Risiko-Score für Patienten",
  "evaluationMetrics": ["Accuracy", "Precision", "Recall", "F1-Score"],
  "toolsAnalysis": "Python, scikit-learn, TensorFlow"
}

### 7. 🎯 WIZARD ABSCHLIESSEN + BERECHNUNG TRIGGERN
POST http://localhost:8080/api/projects/1/complete-wizard

> {%
    client.test("Wizard completed", function() {
        client.assert(response.status === 200, "Response status is 200");
        client.assert(response.body.success === true, "Success is true");
        client.assert(response.body.data.metrics, "Metrics wurden berechnet");
    });

    client.log("✅ Wizard abgeschlossen!");
    client.log("📊 Metrics:", JSON.stringify(response.body.data.metrics, null, 2));
%}

### 8. Dashboard abrufen (nach Berechnung)
GET http://localhost:8080/api/dashboard/1

### 9. Timeline/Gantt abrufen
GET http://localhost:8080/api/dashboard/1/timeline

### 10. Projektliste (Startpage)
GET http://localhost:8080/api/startpage

### 11. Statistiken
GET http://localhost:8080/api/startpage/statistics

### 12. Default Config abrufen
GET http://localhost:8080/api/config/fields/default

### 13. Default Weights abrufen
GET http://localhost:8080/api/config/weights/default

### 14. Direkte Berechnung (ohne DB-Speicherung)
POST http://localhost:8080/api/calculation/estimate
Content-Type: application/json

{
  "projectType": "CLASSIC_ML",
  "teamSize": 5,
  "inputs": [
    {
