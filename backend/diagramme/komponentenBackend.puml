@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
left to right direction

System("Backend", "Backend", "<<system>>")
ContainerDb("postgresql", "PostgreSQL", "<<system>>", "Datenbank")

Boundary("entry", "Entry Point & Routing") {
    Component("index", "index.ts", "", "Server Start & Middleware")
    Component("routes", "Routes", "", "API Endpunkte & Validierung")
}

Boundary("logic", "Business Logic") {
    Component("services", "Services", "", "Geschäftslogik & Berechnungen")
}

Boundary("data", "Data Access") {
    Component("prisma", "Prisma", "", "ORM & SQL Abstraktion")
}

Boundary("shared", "Shared Resources") {
    Component("types", "Types", "", "Interfaces & Datenmodelle")
}

Rel("Backend", "index", "HTTP Request")
Rel("index", "routes", "leitet weiter")

Rel("routes", "services", "ruft auf")
Rel("routes", "types", "nutzt Typen")

Rel("services", "prisma", "fragt Daten ab")
Rel("services", "types", "nutzt Typen")

Rel("prisma", "postgresql", "SQL Query")
Rel("prisma", "types", "generiert Typen")

@enduml
